# Garmin Connect credentials
GARMIN_EMAIL=your-email@example.com
GARMIN_PASSWORD=your-password

# Optional: custom token store path
# If path is a directory, garmin_tokens.json will be used inside it.
# Default: /app/data/garmin_tokens/garmin_tokens.json
# TOKEN_STORE_PATH=/app/data/garmin_tokens/garmin_tokens.json
